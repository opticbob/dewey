<div class="section-header" id="checkouts">
    <h2 class="section-title">📖 Current Checkouts (<%= checkouts.length %>)</h2>
</div>

<div class="table-container">
    <table class="items-table">
        <thead>
            <tr>
                <th class="col-thumb"></th>
                <th>Title / Author</th>
                <th class="col-type">Type</th>
                <th class="col-due">Due Date</th>
                <% if show_patron %>
                    <th class="col-patron">Patron</th>
                <% end %>
            </tr>
        </thead>
        <tbody>
            <% checkouts.each do |item| %>
                <tr class="<%= item['missing_scrapes'] ? 'item-missing' : '' %>">
                    <td class="thumbnail-cell">
                        <img src="<%= item['thumbnail_url'] || '/placeholder.jpg' %>" alt="<%= item['title'] %>" class="table-thumbnail" loading="lazy">
                    </td>
                    <td class="title-cell">
                        <div class="title-main">
                            <%= item['title'] %>
                            <% if item['missing_scrapes'] %>
                                <span class="missing-badge" title="Not seen in the last <%= item['missing_scrapes'] %> scrape<%= item['missing_scrapes'] == 1 ? '' : 's' %>">
                                    ⚠️ not seen in last <%= item['missing_scrapes'] %> scrape<%= item['missing_scrapes'] == 1 ? '' : 's' %>
                                </span>
                            <% end %>
                        </div>
                        <% if item['subtitle'] && !item['subtitle'].empty? %>
                            <div class="title-subtitle"><%= item['subtitle'] %></div>
                        <% end %>
                        <div class="title-author"><%= item['author'] || 'Unknown Author' %></div>
                    </td>
                    <td class="type-cell" data-label="Type">
                        <span class="badge badge-type"><%= item['type'] || 'Book' %></span>
                    </td>
                    <td class="due-cell" data-label="Due">
                        <div class="<%= due_date_class(item['due_date']) %>">
                            <%= format_due_date(item['due_date']) %>
                        </div>
                        <% if item['renewable'] %>
                            <div class="renewable-badge">✓ Renewable</div>
                        <% end %>
                    </td>
                    <% if show_patron %>
                        <td class="patron-cell" data-label="Patron">
                            <span class="badge badge-patron"><%= item['patron_name'] %></span>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
