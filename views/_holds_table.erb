<div class="section-header" id="holds">
    <h2 class="section-title">📋 Current Holds (<%= holds.length %>)</h2>
</div>

<div class="table-container">
    <table class="items-table">
        <thead>
            <tr>
                <th class="col-thumb"></th>
                <th>Title / Author</th>
                <th class="col-type">Type</th>
                <th class="col-status">Status</th>
                <th class="col-position">Position</th>
                <th class="col-checkout">Checkout By</th>
                <% if show_patron %>
                    <th class="col-patron">Patron</th>
                <% end %>
            </tr>
        </thead>
        <tbody>
            <% holds.each do |item| %>
                <tr>
                    <td class="thumbnail-cell">
                        <img src="<%= item['thumbnail_url'] || '/placeholder.jpg' %>" alt="<%= item['title'] %>" class="table-thumbnail" loading="lazy">
                    </td>
                    <td class="title-cell">
                        <div class="title-main"><%= item['title'] %></div>
                        <% if item['subtitle'] && !item['subtitle'].empty? %>
                            <div class="title-subtitle"><%= item['subtitle'] %></div>
                        <% end %>
                        <div class="title-author"><%= item['author'] || 'Unknown Author' %></div>
                    </td>
                    <td class="type-cell" data-label="Type">
                        <span class="badge badge-type"><%= item['type'] || 'Book' %></span>
                    </td>
                    <td class="status-cell" data-label="Status">
                        <span class="badge <%= status_class(item['status']) %>">
                            <%= item['status'] || 'In Queue' %>
                        </span>
                    </td>
                    <td class="position-cell" data-label="Position">
                        <% if item['queue_position'] %>
                            <span class="queue-position">#<%= item['queue_position'] %></span>
                        <% else %>
                            <span style="color: #999;">—</span>
                        <% end %>
                    </td>
                    <td class="checkout-cell" data-label="Checkout by">
                        <% status = item['status']&.downcase&.strip || "" %>
                        <% if status == "not ready" %>
                            <span style="color: #999;">—</span>
                        <% else %>
                            <% deadline_date = item['checkout_by'] || item['expires_on'] %>
                            <% if deadline_date %>
                                <div class="<%= due_date_class(deadline_date) %>">
                                    <%= format_due_date(deadline_date) %>
                                </div>
                            <% else %>
                                <span style="color: #999;">—</span>
                            <% end %>
                        <% end %>
                    </td>
                    <% if show_patron %>
                        <td class="patron-cell" data-label="Patron">
                            <span class="badge badge-patron"><%= item['patron_name'] %></span>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
